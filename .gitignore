# Build output
dist/
!dist/.gitkeep
**/png_output/

# Node (optional tooling)
node_modules/

# Python (optional tooling)
__pycache__/
*.pyc
.venv/

# OS / editor
.DS_Store
Thumbs.db
.vscode/*.log

# Local setup artifacts
*.tmp
tmp/

# Transient / compile-next-to-source PDFs (rebuild with typst)
src/main.pdf
src/**/*.pdf
test/**/*.pdf
toolset/compose/spikes/**/*.pdf
# Skill eval iteration outputs (keep evals.json + NOTES)
**/skill/*-workspace/**/outputs/*.pdf
**/skill/*-workspace/**/review.html

# Root-level scratch experiment outputs (keep sources in test/)
/test*.png
/test*.pdf
/test*_b64.txt
/test*_preview.html
/scratch_test.*
/v-*-compile.typ

# Intermediate AI vision drafts (commit only accepted / canonical refs; see domains/medical/assets/CANONICAL.md)
# Do not re-add purged intermediate gemini variants without MANIFEST status=accepted
